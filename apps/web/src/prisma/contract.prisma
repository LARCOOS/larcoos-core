// use prisma-8

model Truckload {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  supplier    String
  retailer    String
  pallets     Int
  purchase    Decimal
  freight     Decimal
  destination String
  status      String   @default("Planned")
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}
// use prisma-8

// ============================================================
// LARCOOS KERNEL v0.4
//
// Core:
// Organizations
// Organization Memberships
// Locations
// Actors
// Roles / Permissions
// Authentication
// Sessions
// Kernel Events / Audit Trail
//
// Multi-organization principle:
//
// Actor = permanent person/system identity.
//
// OrganizationMembership = authorization of that Actor
// inside one specific organization/workspace.
//
// One Actor may therefore belong to multiple organizations
// with different roles and permissions.
//
// TRANSITIONAL COMPATIBILITY:
//
// Actor.organizationId remains temporarily as the Actor's
// primary/legacy organization.
//
// Actor.systemRole and Actor permission flags also remain
// temporarily so existing LARCOOS modules continue working
// while authorization migrates to OrganizationMembership.
//
// New organization-aware authorization should prefer:
//
// Actor
//   -> OrganizationMembership
//   -> Organization
//
// Security principle:
// Operational role != system authorization.
//
// Example:
// A person may work as "Forklift Operator" during unloading
// while their organization membership role is EMPLOYEE.
//
// Completed records are immutable for normal employees.
// Authorized managers/admins may correct completed records,
// but the original action remains preserved in KernelEvent.
//
// Authentication principle:
//
// Actor = permanent LARCOOS identity.
// AuthAccount = login credentials.
// AuthSession = authenticated revocable session.
//
// Authentication identifies WHO the person is.
//
// OrganizationMembership determines WHAT that authenticated
// Actor may do inside a specific organization.
//
// Passwords are NEVER stored directly.
// AuthAccount.passwordHash stores only a secure password hash.
//
// Browser session tokens are NEVER stored directly.
// AuthSession.tokenHash stores only a cryptographic hash of
// the opaque session token supplied to the browser.
// ============================================================

model Organization {
  id        Int    @id @default(autoincrement())
  code      String @unique
  name      String
  legalName String?
  type      String
  country   String?
  currency  String?

  isActive Boolean @default(true)

  locations   Location[]
  actors      Actor[]
  memberships OrganizationMembership[]
  events      KernelEvent[]
  truckloads  Truckload[]
  sales       Sale[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// ORGANIZATION MEMBERSHIP
//
// Connects one permanent Actor identity to one Organization.
//
// Authorization belongs here because the same Actor may have
// different authority in different organizations.
//
// Example:
//
// Victor
//   -> LDC LLC      -> OWNER_ADMIN
//   -> ViDaMar      -> MANAGER
//   -> Future Co.   -> VIEWER
//
// Authentication remains attached to Actor/AuthAccount.
// Membership does NOT create another login.
//
// Exactly one membership per Actor + Organization.
//
// During Kernel v0.4 migration, Actor.organizationId and the
// authorization fields on Actor remain for compatibility.
// They will not be removed until existing operational APIs
// have migrated to organization-aware authorization.
// ============================================================

model OrganizationMembership {
  id             Int @id @default(autoincrement())
  organizationId Int
  actorId        Int

  systemRole String @default("EMPLOYEE")

  canEditCompletedRecords Boolean @default(false)
  canManageUsers          Boolean @default(false)
  canApproveFinancials    Boolean @default(false)
  canManageKernel         Boolean @default(false)

  isActive Boolean @default(true)

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  actor Actor @relation(
    fields: [actorId],
    references: [id],
    onDelete: Cascade
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([organizationId, actorId])
  @@index([actorId])
}

// ============================================================
// LOCATION
// ============================================================

model Location {
  id             Int @id @default(autoincrement())
  organizationId Int

  code String @unique
  name String
  type String

  addressLine1 String?
  addressLine2 String?
  city         String?
  stateRegion  String?
  postalCode   String?
  country      String?
  timezone     String?

  isActive Boolean @default(true)

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  events     KernelEvent[]
  truckloads Truckload[]
  sales      Sale[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([organizationId, name])
}

// ============================================================
// ACTOR
//
// Actor represents a permanent person/system identity.
//
// IMPORTANT:
//
// Authentication belongs to Actor through AuthAccount.
//
// Organization-specific authorization belongs to
// OrganizationMembership.
//
// TRANSITIONAL:
//
// organizationId remains the primary/legacy organization.
//
// systemRole and permission flags remain temporarily for
// compatibility with existing authorization code.
//
// Operational roles such as:
// Receiver
// Forklift Operator
// Warehouse Unloader
// Supervisor
//
// remain separate from system authorization.
// ============================================================

model Actor {
  id             Int @id @default(autoincrement())
  organizationId Int?

  code        String @unique
  displayName String
  type        String

  email String?
  phone String?

  // -----------------------------------------
  // LEGACY / TRANSITIONAL AUTHORIZATION
  // -----------------------------------------

  systemRole String @default("EMPLOYEE")

  canEditCompletedRecords Boolean @default(false)
  canManageUsers          Boolean @default(false)
  canApproveFinancials    Boolean @default(false)
  canManageKernel         Boolean @default(false)

  isActive Boolean @default(true)

  // Primary/legacy organization.
  // OrganizationMembership is the new multi-org authority.
  organization Organization? @relation(
    fields: [organizationId],
    references: [id],
    onDelete: SetNull
  )

  memberships      OrganizationMembership[]
  authAccount      AuthAccount?
  events           KernelEvent[]
  unloadingWorkers UnloadingWorker[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// AUTH ACCOUNT
//
// One login account per Actor.
//
// loginIdentifier is normalized by the application before
// storing/querying it.
//
// Example:
// victor@larcoos.com
//
// passwordHash NEVER contains the original password.
// The application will use a salted password derivation
// algorithm and store only its encoded hash.
//
// Failed-login tracking supports account lockouts without
// modifying Actor authorization or audit history.
// ============================================================

model AuthAccount {
  id      Int @id @default(autoincrement())
  actorId Int @unique

  loginIdentifier String @unique
  passwordHash    String

  isActive Boolean @default(true)

  failedLoginAttempts Int @default(0)
  lockedUntil         TimestamptzString?

  lastLoginAt       TimestamptzString?
  passwordChangedAt TimestamptzString?

  actor Actor @relation(
    fields: [actorId],
    references: [id],
    onDelete: Cascade
  )

  sessions AuthSession[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// AUTH SESSION
//
// Browser receives a random opaque session token.
//
// IMPORTANT:
// Raw token exists only in the secure browser cookie.
// Database stores SHA-256(token) as tokenHash.
//
// This allows:
// - logout
// - forced logout
// - employee/session revocation
// - session expiration
// - credential rotation
//
// revokedAt != null means session is no longer valid.
// expiresAt is always checked server-side.
// ============================================================

model AuthSession {
  id        Int @id @default(autoincrement())
  accountId Int

  tokenHash String @unique

  expiresAt  TimestamptzString
  lastSeenAt TimestamptzString?
  revokedAt  TimestamptzString?

  account AuthAccount @relation(
    fields: [accountId],
    references: [id],
    onDelete: Cascade
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// KERNEL EVENT / IMMUTABLE AUDIT TRAIL
//
// Important actions leave a footprint.
//
// Examples:
//
// TRUCKLOAD_PURCHASED
// PAYMENT_RECEIVED
// TRUCK_RECEIVED
// UNLOADING_STARTED
// PALLET_UNLOADED
// UNLOADING_FINISHED
// ITEM_INSPECTED
// PALLET_PROCESSED
// MANIFEST_CREATED
// AI_PRICE_RECOMMENDED
// INVENTORY_TRANSFERRED_TO_VIDAMAR
// AUCTION_STARTED
// ITEM_SOLD
// CASH_RECEIVED
//
// Authentication / security:
//
// AUTH_LOGIN_SUCCEEDED
// AUTH_LOGIN_FAILED
// AUTH_LOGOUT
// AUTH_SESSION_REVOKED
//
// Organization membership:
//
// ORGANIZATION_MEMBERSHIP_CREATED
// ORGANIZATION_MEMBERSHIP_UPDATED
// ORGANIZATION_MEMBERSHIP_DEACTIVATED
// KERNEL_ORGANIZATION_MEMBERSHIP_INITIALIZED
//
// Administrative corrections:
//
// COMPLETED_RECORD_EDIT_REQUESTED
// COMPLETED_RECORD_CORRECTED
//
// payload may preserve:
//
// {
//   "reason": "...",
//   "before": {...},
//   "after": {...},
//   "authorizedBy": "..."
// }
//
// KernelEvent should be treated as append-only history.
// ============================================================

model KernelEvent {
  id Int @id @default(autoincrement())

  eventId   String @unique
  eventType String

  organizationId Int?
  locationId     Int?
  actorId        Int?

  entityType String
  entityId   String
  entityCode String?

  source String @default("LARCOOS")

  payload String?

  occurredAt TimestamptzString @default(now())
  createdAt  TimestamptzString @default(now())

  organization Organization? @relation(
    fields: [organizationId],
    references: [id],
    onDelete: SetNull
  )

  location Location? @relation(
    fields: [locationId],
    references: [id],
    onDelete: SetNull
  )

  actor Actor? @relation(
    fields: [actorId],
    references: [id],
    onDelete: SetNull
  )
}

// ============================================================
// LDC — TRUCKLOAD
//
// Operational lifecycle:
//
// Planned
// Purchased
// Shipping
// Received
// Unloading
// Unloaded
// Processing
// Processed
// Manifested
// Ready for Sale
// Selling
// Sold
//
// Payment lifecycle is separate:
//
// Unpaid
// Partial
// Paid in Full
// ============================================================

model Truckload {
  id   Int    @id @default(autoincrement())
  code String @unique

  organizationId Int?
  locationId     Int?

  supplier    String
  retailer    String
  pallets     Int
  purchase    Decimal
  freight     Decimal
  destination String

  status String @default("Planned")

  // -----------------------------------------
  // PAYMENT
  // -----------------------------------------

  paymentMethod  String @default("Unspecified")
  paymentStatus  String @default("Unpaid")
  amountPaid     Decimal
  paymentDueDate TimestamptzString?
  paymentCountry String?

  organization Organization? @relation(
    fields: [organizationId],
    references: [id],
    onDelete: SetNull
  )

  location Location? @relation(
    fields: [locationId],
    references: [id],
    onDelete: SetNull
  )

  palletRecords Pallet[]
  receiving     TruckReceiving?
  sales         Sale[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// LDC — PALLET
// ============================================================

model Pallet {
  id          Int    @id @default(autoincrement())
  code        String @unique
  truckloadId Int

  palletNumber Int

  status String @default("Pending")

  description String?
  category    String?
  condition   String?
  notes       String?

  estimatedPieces Int?
  processedPieces Int @default(0)

  // Processing v1
  //
  // SOURCE:
  // Pallet received from the original supplier/truckload.
  //
  // LDC_BUILT:
  // New pallet assembled by LDC after processing/classification.
  palletType String @default("SOURCE")

  // FULL_PROCESSING:
  // LDC opens/processes merchandise and may create unit records.
  //
  // PALLET_VERIFICATION:
  // LDC keeps merchandise palletized and verifies the pallet only.
  processingMode String?

  // MANIFEST_ONLY
  // PALLET_VERIFIED
  // PHYSICALLY_VERIFIED
  // FUNCTION_TESTED
  // SALE_READY
  verificationLevel String @default("MANIFEST_ONLY")

  // For an LDC_BUILT pallet, records the primary source pallet when
  // there is one. Full many-to-many genealogy can be added later.
  sourcePalletId Int?

  // True after LDC has completed the processing/verification required
  // for this pallet's selected processing mode.
  processingCompleted Boolean @default(false)

  // True when the pallet is eligible to appear on an LDC manifest.
  manifestReady Boolean @default(false)

  truckload Truckload @relation(
    fields: [truckloadId],
    references: [id],
    onDelete: Cascade
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([truckloadId, palletNumber])
}

// ============================================================
// LDC — INVENTORY UNIT / PROCESSING v1
// ============================================================
//
// Created only when merchandise is processed at unit level.
// PALLET_VERIFICATION does not require unit records.
//
// This is LDC operational inventory. A future ViDaMar inventory
// record will be separate and linked through cross-organization
// transfer / lineage instead of changing ownership of this row.
//

model InventoryUnit {
  id Int @id @default(autoincrement())

  // Permanent LDC identity, for example:
  // LDC-2026-001-P01-I0001
  unitId String @unique

  organizationId Int
  truckloadId    Int

  // Current LDC pallet after processing/repacking.
  palletId Int?

  // Original supplier/source pallet when known.
  sourcePalletId Int?

  // Sequence inside the processed pallet/truckload.
  unitNumber Int

  // Product identity
  upc          String?
  sku          String?
  manufacturer String?
  brand        String?
  model        String?
  serialNumber String?

  title       String?
  description String?
  category    String?

  // NEW_SEALED
  // NEW_OPEN_BOX
  // USED_LIKE_NEW
  // USED_GOOD
  // USED
  // DAMAGED
  condition String?

  // MANIFEST_ONLY
  // PHYSICALLY_VERIFIED
  // FUNCTION_TESTED
  // SALE_READY
  verificationLevel String @default("MANIFEST_ONLY")

  // SALE_READY
  // CLEANING
  // REPAIR
  // BACKYARD
  // SALVAGE
  // DISPOSAL
  disposition String @default("SALE_READY")

  // Processing state is independent from commercial state.
  processingStatus String @default("PENDING")

  // Cost belongs to accounting/history.
  assignedCost Decimal?

  // Pricing is a recommendation/decision and must not rewrite cost.
  suggestedPrice Decimal?
  actualListPrice Decimal?

  currency String @default("USD")

  // Future AI pricing/identification metadata.
  aiConfidence Decimal?
  aiMetadata   String?

  notes String?

  processedAt TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([truckloadId, unitNumber])
  @@index([organizationId])
  @@index([truckloadId])
  @@index([palletId])
  @@index([sourcePalletId])
  @@index([upc])
  @@index([sku])
  @@index([serialNumber])
  @@index([verificationLevel])
  @@index([disposition])
  @@index([processingStatus])
}

// ============================================================
// ============================================================
// LDC — RECEIVING / UNLOADING
//
// One receiving record per truckload.
//
// Lifecycle:
//
// Shipping
//   -> Received
//   -> Unloading
//   -> Unloaded
//
// Once unloading is completed, operational information should
// normally be considered locked.
//
// A Manager/Admin correction must:
//
// 1. Verify authenticated Actor.
// 2. Resolve authorization inside the Organization.
// 3. Require a reason.
// 4. Preserve old values.
// 5. Apply corrected values.
// 6. Create COMPLETED_RECORD_CORRECTED KernelEvent.
// ============================================================

model TruckReceiving {
  id          Int @id @default(autoincrement())
  truckloadId Int @unique

  // -----------------------------------------
  // ARRIVAL
  // -----------------------------------------

  receivedAt TimestamptzString?

  originName    String?
  originCity    String?
  originState   String?
  originCountry String?

  carrierName String?
  driverName  String?
  driverPhone String?

  truckNumber   String?
  trailerNumber String?

  // -----------------------------------------
  // FREIGHT / TRANSPORT METRICS
  // -----------------------------------------

  distanceMiles Int?

  freightCost Decimal?

  // Stored when known/calculated so historical
  // reports preserve the value used at the time.

  costPerMile   Decimal?
  costPerPallet Decimal?

  // -----------------------------------------
  // UNLOADING TIMER
  // -----------------------------------------

  unloadingStartedAt  TimestamptzString?
  unloadingFinishedAt TimestamptzString?

  unloadingSeconds Int?

  palletsExpected Int?
  palletsUnloaded Int @default(0)

  // -----------------------------------------
  // EQUIPMENT / OPERATION
  // -----------------------------------------

  forkliftUsed Boolean @default(false)
  forkliftName String?

  dockDoor String?
  notes    String?

  truckload Truckload @relation(
    fields: [truckloadId],
    references: [id],
    onDelete: Cascade
  )

  workers UnloadingWorker[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// LDC — UNLOADING WORKERS
//
// Operational role only.
//
// Examples:
//
// Forklift Operator
// Warehouse Unloader
// Receiver
// Supervisor
//
// This role DOES NOT grant system permissions.
//
// Current transitional authorization may still use Actor
// permissions.
//
// Organization-aware authorization will use:
//
// Actor -> OrganizationMembership -> Organization
// ============================================================

model UnloadingWorker {
  id          Int @id @default(autoincrement())
  receivingId Int
  actorId     Int?

  workerName String
  role       String

  startedAt  TimestamptzString?
  finishedAt TimestamptzString?

  workSeconds Int?

  notes String?

  receiving TruckReceiving @relation(
    fields: [receivingId],
    references: [id],
    onDelete: Cascade
  )

  actor Actor? @relation(
    fields: [actorId],
    references: [id],
    onDelete: SetNull
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([receivingId, workerName, role])
}
// ============================================================
// SALES ENGINE v1
//
// Sale represents revenue generated by an Organization.
//
// IMPORTANT:
// Truckload.payment* represents procurement-side payment
// from LDC to the supplier.
//
// Sale / SalePayment represents customer-side revenue
// received by LDC.
//
// A Sale may originate from a Truckload today.
// Future versions may additionally link Pallets, Items,
// Listings, Auctions, POS Orders and Marketplace Orders.
//
// Payment history is stored separately so partial and
// multiple payments remain traceable.
// ============================================================

model Sale {
  id Int @id @default(autoincrement())

  code String @unique

  organizationId Int
  locationId     Int?
  truckloadId    Int?

  customerName String?

  status        String @default("Open")
  paymentStatus String @default("Unpaid")
  paymentMethod String @default("Unspecified")

  currency String @default("USD")

  grossAmount    Decimal
  amountReceived Decimal @default("0")

  saleDate TimestamptzString @default(now())
  notes    String?

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  location Location? @relation(
    fields: [locationId],
    references: [id],
    onDelete: SetNull
  )

  truckload Truckload? @relation(
    fields: [truckloadId],
    references: [id],
    onDelete: SetNull
  )

  payments SalePayment[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([organizationId])
  @@index([locationId])
  @@index([truckloadId])
  @@index([saleDate])
  @@index([paymentStatus])
}

model SalePayment {
  id     Int @id @default(autoincrement())
  saleId Int

  amount   Decimal
  currency String @default("USD")
  method   String @default("Unspecified")

  reference String?
  notes     String?

  receivedAt TimestamptzString @default(now())

  sale Sale @relation(
    fields: [saleId],
    references: [id],
    onDelete: Cascade
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([saleId])
  @@index([receivedAt])
}
// ============================================================
// LARCOOS — UNIVERSAL EVIDENCE LAYER v1
// ============================================================

model EvidenceAsset {
  id Int @id @default(autoincrement())

  evidenceId String @unique

  organizationId    Int?
  locationId        Int?
  uploadedByActorId Int?
  kernelEventId     Int?

  entityType String
  entityId   String
  entityCode String?

  category String
  purpose  String?

  fileType         String?
  mimeType         String?
  originalFilename String

  storageKey String @unique
  sha256     String

  sizeBytes Int?

  capturedAt TimestamptzString?
  uploadedAt TimestamptzString @default(now())

  source String @default("LARCOOS")

  verificationStatus String @default("UNVERIFIED")

  metadata String?

  retentionPolicy String @default("BUSINESS_RECORD")

  supersededById Int?

  isActive Boolean @default(true)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([organizationId])
  @@index([locationId])
  @@index([uploadedByActorId])
  @@index([kernelEventId])
  @@index([entityType, entityId])
  @@index([entityType, entityCode])
  @@index([category])
  @@index([sha256])
  @@index([verificationStatus])
  @@index([uploadedAt])
  @@index([supersededById])
}

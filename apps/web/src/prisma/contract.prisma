// use prisma-8

// ============================================================
// LARCOOS KERNEL v0.4
//
// Core:
// Organizations
// Organization Memberships
// Locations
// Actors
// Roles / Permissions
// Authentication
// Sessions
// Kernel Events / Audit Trail
//
// Multi-organization principle:
//
// Actor = permanent person/system identity.
//
// OrganizationMembership = authorization of that Actor
// inside one specific organization/workspace.
//
// One Actor may therefore belong to multiple organizations
// with different roles and permissions.
//
// TRANSITIONAL COMPATIBILITY:
//
// Actor.organizationId remains temporarily as the Actor's
// primary/legacy organization.
//
// Actor.systemRole and Actor permission flags also remain
// temporarily so existing LARCOOS modules continue working
// while authorization migrates to OrganizationMembership.
//
// New organization-aware authorization should prefer:
//
// Actor
//   -> OrganizationMembership
//   -> Organization
//
// Security principle:
// Operational role != system authorization.
//
// Example:
// A person may work as "Forklift Operator" during unloading
// while their organization membership role is EMPLOYEE.
//
// Completed records are immutable for normal employees.
// Authorized managers/admins may correct completed records,
// but the original action remains preserved in KernelEvent.
//
// Authentication principle:
//
// Actor = permanent LARCOOS identity.
// AuthAccount = login credentials.
// AuthSession = authenticated revocable session.
//
// Authentication identifies WHO the person is.
//
// OrganizationMembership determines WHAT that authenticated
// Actor may do inside a specific organization.
//
// Passwords are NEVER stored directly.
// AuthAccount.passwordHash stores only a secure password hash.
//
// Browser session tokens are NEVER stored directly.
// AuthSession.tokenHash stores only a cryptographic hash of
// the opaque session token supplied to the browser.
// ============================================================

model Organization {
  id        Int    @id @default(autoincrement())
  code      String @unique
  name      String
  legalName String?
  type      String
  country   String?
  currency  String?

  isActive Boolean @default(true)

  locations   Location[]
  actors      Actor[]
  memberships OrganizationMembership[]
  events      KernelEvent[]
  truckloads  Truckload[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// ORGANIZATION MEMBERSHIP
//
// Connects one permanent Actor identity to one Organization.
//
// Authorization belongs here because the same Actor may have
// different authority in different organizations.
//
// Example:
//
// Victor
//   -> LDC LLC      -> OWNER_ADMIN
//   -> ViDaMar      -> MANAGER
//   -> Future Co.   -> VIEWER
//
// Authentication remains attached to Actor/AuthAccount.
// Membership does NOT create another login.
//
// Exactly one membership per Actor + Organization.
//
// During Kernel v0.4 migration, Actor.organizationId and the
// authorization fields on Actor remain for compatibility.
// They will not be removed until existing operational APIs
// have migrated to organization-aware authorization.
// ============================================================

model OrganizationMembership {
  id             Int @id @default(autoincrement())
  organizationId Int
  actorId        Int

  systemRole String @default("EMPLOYEE")

  canEditCompletedRecords Boolean @default(false)
  canManageUsers          Boolean @default(false)
  canApproveFinancials    Boolean @default(false)
  canManageKernel         Boolean @default(false)

  isActive Boolean @default(true)

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  actor Actor @relation(
    fields: [actorId],
    references: [id],
    onDelete: Cascade
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([organizationId, actorId])
  @@index([actorId])
}

// ============================================================
// LOCATION
// ============================================================

model Location {
  id             Int @id @default(autoincrement())
  organizationId Int

  code String @unique
  name String
  type String

  addressLine1 String?
  addressLine2 String?
  city         String?
  stateRegion  String?
  postalCode   String?
  country      String?
  timezone     String?

  isActive Boolean @default(true)

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  events     KernelEvent[]
  truckloads Truckload[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([organizationId, name])
}

// ============================================================
// ACTOR
//
// Actor represents a permanent person/system identity.
//
// IMPORTANT:
//
// Authentication belongs to Actor through AuthAccount.
//
// Organization-specific authorization belongs to
// OrganizationMembership.
//
// TRANSITIONAL:
//
// organizationId remains the primary/legacy organization.
//
// systemRole and permission flags remain temporarily for
// compatibility with existing authorization code.
//
// Operational roles such as:
// Receiver
// Forklift Operator
// Warehouse Unloader
// Supervisor
//
// remain separate from system authorization.
// ============================================================

model Actor {
  id             Int @id @default(autoincrement())
  organizationId Int?

  code        String @unique
  displayName String
  type        String

  email String?
  phone String?

  // -----------------------------------------
  // LEGACY / TRANSITIONAL AUTHORIZATION
  // -----------------------------------------

  systemRole String @default("EMPLOYEE")

  canEditCompletedRecords Boolean @default(false)
  canManageUsers          Boolean @default(false)
  canApproveFinancials    Boolean @default(false)
  canManageKernel         Boolean @default(false)

  isActive Boolean @default(true)

  // Primary/legacy organization.
  // OrganizationMembership is the new multi-org authority.
  organization Organization? @relation(
    fields: [organizationId],
    references: [id],
    onDelete: SetNull
  )

  memberships      OrganizationMembership[]
  authAccount      AuthAccount?
  events           KernelEvent[]
  unloadingWorkers UnloadingWorker[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// AUTH ACCOUNT
//
// One login account per Actor.
//
// loginIdentifier is normalized by the application before
// storing/querying it.
//
// Example:
// victor@larcoos.com
//
// passwordHash NEVER contains the original password.
// The application will use a salted password derivation
// algorithm and store only its encoded hash.
//
// Failed-login tracking supports account lockouts without
// modifying Actor authorization or audit history.
// ============================================================

model AuthAccount {
  id      Int @id @default(autoincrement())
  actorId Int @unique

  loginIdentifier String @unique
  passwordHash    String

  isActive Boolean @default(true)

  failedLoginAttempts Int @default(0)
  lockedUntil         TimestamptzString?

  lastLoginAt       TimestamptzString?
  passwordChangedAt TimestamptzString?

  actor Actor @relation(
    fields: [actorId],
    references: [id],
    onDelete: Cascade
  )

  sessions AuthSession[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// AUTH SESSION
//
// Browser receives a random opaque session token.
//
// IMPORTANT:
// Raw token exists only in the secure browser cookie.
// Database stores SHA-256(token) as tokenHash.
//
// This allows:
// - logout
// - forced logout
// - employee/session revocation
// - session expiration
// - credential rotation
//
// revokedAt != null means session is no longer valid.
// expiresAt is always checked server-side.
// ============================================================

model AuthSession {
  id        Int @id @default(autoincrement())
  accountId Int

  tokenHash String @unique

  expiresAt  TimestamptzString
  lastSeenAt TimestamptzString?
  revokedAt  TimestamptzString?

  account AuthAccount @relation(
    fields: [accountId],
    references: [id],
    onDelete: Cascade
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// KERNEL EVENT / IMMUTABLE AUDIT TRAIL
//
// Important actions leave a footprint.
//
// Examples:
//
// TRUCKLOAD_PURCHASED
// PAYMENT_RECEIVED
// TRUCK_RECEIVED
// UNLOADING_STARTED
// PALLET_UNLOADED
// UNLOADING_FINISHED
// ITEM_INSPECTED
// PALLET_PROCESSED
// MANIFEST_CREATED
// AI_PRICE_RECOMMENDED
// INVENTORY_TRANSFERRED_TO_VIDAMAR
// AUCTION_STARTED
// ITEM_SOLD
// CASH_RECEIVED
//
// Authentication / security:
//
// AUTH_LOGIN_SUCCEEDED
// AUTH_LOGIN_FAILED
// AUTH_LOGOUT
// AUTH_SESSION_REVOKED
//
// Organization membership:
//
// ORGANIZATION_MEMBERSHIP_CREATED
// ORGANIZATION_MEMBERSHIP_UPDATED
// ORGANIZATION_MEMBERSHIP_DEACTIVATED
// KERNEL_ORGANIZATION_MEMBERSHIP_INITIALIZED
//
// Administrative corrections:
//
// COMPLETED_RECORD_EDIT_REQUESTED
// COMPLETED_RECORD_CORRECTED
//
// payload may preserve:
//
// {
//   "reason": "...",
//   "before": {...},
//   "after": {...},
//   "authorizedBy": "..."
// }
//
// KernelEvent should be treated as append-only history.
// ============================================================

model KernelEvent {
  id Int @id @default(autoincrement())

  eventId   String @unique
  eventType String

  organizationId Int?
  locationId     Int?
  actorId        Int?

  entityType String
  entityId   String
  entityCode String?

  source String @default("LARCOOS")

  payload String?

  occurredAt TimestamptzString @default(now())
  createdAt  TimestamptzString @default(now())

  organization Organization? @relation(
    fields: [organizationId],
    references: [id],
    onDelete: SetNull
  )

  location Location? @relation(
    fields: [locationId],
    references: [id],
    onDelete: SetNull
  )

  actor Actor? @relation(
    fields: [actorId],
    references: [id],
    onDelete: SetNull
  )
}

// ============================================================
// LDC — TRUCKLOAD
//
// Operational lifecycle:
//
// Planned
// Purchased
// Shipping
// Received
// Unloading
// Unloaded
// Processing
// Processed
// Manifested
// Ready for Sale
// Selling
// Sold
//
// Payment lifecycle is separate:
//
// Unpaid
// Partial
// Paid in Full
// ============================================================

model Truckload {
  id   Int    @id @default(autoincrement())
  code String @unique

  organizationId Int?
  locationId     Int?

  supplier    String
  retailer    String
  pallets     Int
  purchase    Decimal
  freight     Decimal
  destination String

  status String @default("Planned")

  // -----------------------------------------
  // PAYMENT
  // -----------------------------------------

  paymentMethod  String @default("Unspecified")
  paymentStatus  String @default("Unpaid")
  amountPaid     Decimal
  paymentDueDate TimestamptzString?
  paymentCountry String?

  organization Organization? @relation(
    fields: [organizationId],
    references: [id],
    onDelete: SetNull
  )

  location Location? @relation(
    fields: [locationId],
    references: [id],
    onDelete: SetNull
  )

  palletRecords Pallet[]
  receiving     TruckReceiving?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// LDC — PALLET
// ============================================================

model Pallet {
  id          Int    @id @default(autoincrement())
  code        String @unique
  truckloadId Int

  palletNumber Int

  status String @default("Pending")

  description String?
  category    String?
  condition   String?
  notes       String?

  estimatedPieces Int?
  processedPieces Int @default(0)

  truckload Truckload @relation(
    fields: [truckloadId],
    references: [id],
    onDelete: Cascade
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([truckloadId, palletNumber])
}

// ============================================================
// LDC — RECEIVING / UNLOADING
//
// One receiving record per truckload.
//
// Lifecycle:
//
// Shipping
//   -> Received
//   -> Unloading
//   -> Unloaded
//
// Once unloading is completed, operational information should
// normally be considered locked.
//
// A Manager/Admin correction must:
//
// 1. Verify authenticated Actor.
// 2. Resolve authorization inside the Organization.
// 3. Require a reason.
// 4. Preserve old values.
// 5. Apply corrected values.
// 6. Create COMPLETED_RECORD_CORRECTED KernelEvent.
// ============================================================

model TruckReceiving {
  id          Int @id @default(autoincrement())
  truckloadId Int @unique

  // -----------------------------------------
  // ARRIVAL
  // -----------------------------------------

  receivedAt TimestamptzString?

  originName    String?
  originCity    String?
  originState   String?
  originCountry String?

  carrierName String?
  driverName  String?
  driverPhone String?

  truckNumber   String?
  trailerNumber String?

  // -----------------------------------------
  // FREIGHT / TRANSPORT METRICS
  // -----------------------------------------

  distanceMiles Int?

  freightCost Decimal?

  // Stored when known/calculated so historical
  // reports preserve the value used at the time.

  costPerMile   Decimal?
  costPerPallet Decimal?

  // -----------------------------------------
  // UNLOADING TIMER
  // -----------------------------------------

  unloadingStartedAt  TimestamptzString?
  unloadingFinishedAt TimestamptzString?

  unloadingSeconds Int?

  palletsExpected Int?
  palletsUnloaded Int @default(0)

  // -----------------------------------------
  // EQUIPMENT / OPERATION
  // -----------------------------------------

  forkliftUsed Boolean @default(false)
  forkliftName String?

  dockDoor String?
  notes    String?

  truckload Truckload @relation(
    fields: [truckloadId],
    references: [id],
    onDelete: Cascade
  )

  workers UnloadingWorker[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// LDC — UNLOADING WORKERS
//
// Operational role only.
//
// Examples:
//
// Forklift Operator
// Warehouse Unloader
// Receiver
// Supervisor
//
// This role DOES NOT grant system permissions.
//
// Current transitional authorization may still use Actor
// permissions.
//
// Organization-aware authorization will use:
//
// Actor -> OrganizationMembership -> Organization
// ============================================================

model UnloadingWorker {
  id          Int @id @default(autoincrement())
  receivingId Int
  actorId     Int?

  workerName String
  role       String

  startedAt  TimestamptzString?
  finishedAt TimestamptzString?

  workSeconds Int?

  notes String?

  receiving TruckReceiving @relation(
    fields: [receivingId],
    references: [id],
    onDelete: Cascade
  )

  actor Actor? @relation(
    fields: [actorId],
    references: [id],
    onDelete: SetNull
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([receivingId, workerName, role])
}
// use prisma-8

// ============================================================
// LARCOOS KERNEL v0.1
// ============================================================

model Organization {
  id          Int    @id @default(autoincrement())
  code        String @unique
  name        String
  legalName   String?
  type        String
  country     String?
  currency    String?

  isActive Boolean @default(true)

  locations   Location[]
  actors      Actor[]
  events      KernelEvent[]
  truckloads  Truckload[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Location {
  id             Int @id @default(autoincrement())
  organizationId Int

  code String @unique
  name String
  type String

  addressLine1 String?
  addressLine2 String?
  city         String?
  stateRegion  String?
  postalCode   String?
  country      String?
  timezone     String?

  isActive Boolean @default(true)

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  events     KernelEvent[]
  truckloads Truckload[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([organizationId, name])
}

model Actor {
  id             Int @id @default(autoincrement())
  organizationId Int?

  code        String @unique
  displayName String
  type        String

  email String?
  phone String?

  isActive Boolean @default(true)

  organization Organization? @relation(
    fields: [organizationId],
    references: [id],
    onDelete: SetNull
  )

  events           KernelEvent[]
  unloadingWorkers UnloadingWorker[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// KERNEL EVENT / AUDIT TRAIL
// ============================================================

model KernelEvent {
  id Int @id @default(autoincrement())

  eventId   String @unique
  eventType String

  organizationId Int?
  locationId     Int?
  actorId        Int?

  entityType String
  entityId   String
  entityCode String?

  source  String @default("LARCOOS")
  payload String?

  occurredAt TimestamptzString @default(now())
  createdAt  TimestamptzString @default(now())

  organization Organization? @relation(
    fields: [organizationId],
    references: [id],
    onDelete: SetNull
  )

  location Location? @relation(
    fields: [locationId],
    references: [id],
    onDelete: SetNull
  )

  actor Actor? @relation(
    fields: [actorId],
    references: [id],
    onDelete: SetNull
  )
}

// ============================================================
// LDC — TRUCKLOAD
// ============================================================

model Truckload {
  id   Int    @id @default(autoincrement())
  code String @unique

  organizationId Int?
  locationId     Int?

  supplier    String
  retailer    String
  pallets     Int
  purchase    Decimal
  freight     Decimal
  destination String
  status      String @default("Planned")

  paymentMethod  String @default("Unspecified")
  paymentStatus  String @default("Unpaid")
  amountPaid     Decimal
  paymentDueDate TimestamptzString?
  paymentCountry String?

  organization Organization? @relation(
    fields: [organizationId],
    references: [id],
    onDelete: SetNull
  )

  location Location? @relation(
    fields: [locationId],
    references: [id],
    onDelete: SetNull
  )

  palletRecords Pallet[]
  receiving     TruckReceiving?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// LDC — PALLET
// ============================================================

model Pallet {
  id          Int    @id @default(autoincrement())
  code        String @unique
  truckloadId Int

  palletNumber Int
  status       String @default("Pending")

  description String?
  category    String?
  condition   String?
  notes       String?

  estimatedPieces Int?
  processedPieces Int @default(0)

  truckload Truckload @relation(
    fields: [truckloadId],
    references: [id],
    onDelete: Cascade
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([truckloadId, palletNumber])
}

// ============================================================
// LDC — RECEIVING / UNLOADING
//
// One receiving record per truckload.
//
// Lifecycle:
// Shipping
//   -> Received
//   -> Unloading
//   -> Unloaded
//
// Kernel events will preserve the historical footprint.
// ============================================================

model TruckReceiving {
  id          Int @id @default(autoincrement())
  truckloadId Int @unique

  // -----------------------------------------
  // ARRIVAL
  // -----------------------------------------

  receivedAt TimestamptzString?

  originName    String?
  originCity    String?
  originState   String?
  originCountry String?

  carrierName String?
  driverName  String?
  driverPhone String?

  truckNumber   String?
  trailerNumber String?

  // -----------------------------------------
  // FREIGHT / TRANSPORT METRICS
  // -----------------------------------------

  distanceMiles Int?

  freightCost Decimal?

  // Stored when known/calculated so historical
  // reports preserve the value used at the time.
  costPerMile   Decimal?
  costPerPallet Decimal?

  // -----------------------------------------
  // UNLOADING TIMER
  // -----------------------------------------

  unloadingStartedAt  TimestamptzString?
  unloadingFinishedAt TimestamptzString?

  unloadingSeconds Int?

  palletsExpected Int?
  palletsUnloaded Int @default(0)

  // -----------------------------------------
  // EQUIPMENT / OPERATION
  // -----------------------------------------

  forkliftUsed Boolean @default(false)
  forkliftName String?

  dockDoor String?
  notes    String?

  truckload Truckload @relation(
    fields: [truckloadId],
    references: [id],
    onDelete: Cascade
  )

  workers UnloadingWorker[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ============================================================
// LDC — UNLOADING WORKERS
//
// Employees participating in the unloading operation.
//
// Examples:
// Forklift Operator
// Warehouse Unloader
// Receiver
// Supervisor
// ============================================================

model UnloadingWorker {
  id          Int @id @default(autoincrement())
  receivingId Int
  actorId     Int?

  workerName String
  role       String

  startedAt  TimestamptzString?
  finishedAt TimestamptzString?

  workSeconds Int?

  notes String?

  receiving TruckReceiving @relation(
    fields: [receivingId],
    references: [id],
    onDelete: Cascade
  )

  actor Actor? @relation(
    fields: [actorId],
    references: [id],
    onDelete: SetNull
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([receivingId, workerName, role])
}